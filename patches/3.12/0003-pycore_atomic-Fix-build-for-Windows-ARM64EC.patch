From aba86e0bef5853eb70249464b240296466b73457 Mon Sep 17 00:00:00 2001
From: Andras Lasso <lasso@queensu.ca>
Date: Tue, 27 Oct 2026 15:06:18 -0400
Subject: [PATCH 3/4] pycore_atomic: Fix build for Windows ARM64EC

ARM64EC defines _M_X64 for compatibility with x64 code, so the x64
implementation of the atomic operations is used, but the x64-only HLE
(hardware lock elision) variants of the interlocked intrinsics are not
available. HLE prefixes are only hints, so use the equivalent plain
intrinsics instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Include/internal/pycore_atomic.h | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/Include/internal/pycore_atomic.h b/Include/internal/pycore_atomic.h
index 425d69f..74ac483 100644
--- a/Include/internal/pycore_atomic.h
+++ b/Include/internal/pycore_atomic.h
@@ -18,6 +18,18 @@ extern "C" {
 
 #if defined(_MSC_VER)
 #include <intrin.h>
+#if defined(_M_ARM64EC)
+/* ARM64EC defines _M_X64 but has no HLE (hardware lock elision) intrinsics.
+   HLE prefixes are only hints, so use the equivalent plain intrinsics. */
+#  define _InterlockedExchange_HLEAcquire _InterlockedExchange
+#  define _InterlockedExchange_HLERelease _InterlockedExchange
+#  define _InterlockedExchange64_HLEAcquire _InterlockedExchange64
+#  define _InterlockedExchange64_HLERelease _InterlockedExchange64
+#  define _InterlockedCompareExchange_HLEAcquire _InterlockedCompareExchange
+#  define _InterlockedCompareExchange_HLERelease _InterlockedCompareExchange
+#  define _InterlockedCompareExchange64_HLEAcquire _InterlockedCompareExchange64
+#  define _InterlockedCompareExchange64_HLERelease _InterlockedCompareExchange64
+#endif
 #if defined(_M_IX86) || defined(_M_X64)
 #  include <immintrin.h>
 #endif
